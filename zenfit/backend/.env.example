# Copy this file to .env and fill in real values. Never commit .env.

PORT=8787

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Used to verify Mini App initData and to run the bot.
BOT_TOKEN=123456789:AA-your-bot-token-here
# Deployed Mini App URL the bot's buttons open.
MINI_APP_URL=https://your-frontend.vercel.app
# Bot @username and the Mini App's BotFather-registered short name (the part
# after the slash in t.me/<username>/<shortname>) — both required to build a
# referral link of the form t.me/<username>/<shortname>?startapp=ref_<id>.
# That specific link shape is the only one whose payload rides inside the
# signed initData (see lib/telegramAuth.js); GET /api/referrals/me returns
# link: null until both are set, so referral capture still works without
# them, there is just nothing to share yet.
BOT_USERNAME=
MINI_APP_SHORT_NAME=

# --- Auth -------------------------------------------------------------------
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- AI ---------------------------------------------------------------------
# Powers AI Scan, the trainer chat and meal plans. EITHER key is enough — set
# whichever you have and the backend uses it. With both set, Anthropic wins
# unless AI_PROVIDER says otherwise.
#
# From https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
#
# From https://aistudio.google.com/apikey — has a free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Optional. "anthropic" or "gemini" to pin the choice when both keys are set.
AI_PROVIDER=

# --- Food recognition (optional) --------------------------------------------
# LogMeal looks a dish up in a food database instead of having a language model
# estimate it, so when it recognises the photo its numbers are the better ones.
# Leave this blank and scanning works exactly as before, on the AI key above.
#
# It is tried first and falls through to the AI whenever it is unsure — which
# is the common case for Central Asian dishes, since its training set does not
# cover them and its language list has neither Uzbek nor Russian.
#
# From https://logmeal.com/api — the token shown after verifying your email.
LOGMEAL_API_KEY=

# --- Database ---------------------------------------------------------------
# Supabase / Postgres connection string. When set, Postgres is used.
#
# Use a POOLER host. The direct connection (db.<ref>.supabase.co) is IPv6-only
# and fails with ENOTFOUND on most networks and on Vercel.
#   Transaction pooler, port 6543 -> serverless (Vercel). Preferred.
#   Session pooler,     port 5432 -> long-lived server processes.
# Note the username is postgres.<ref>, not postgres.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# When DATABASE_URL is NOT set, a local SQLite file is used (development only —
# on serverless hosts this file is ephemeral and data is lost).
DATABASE_PATH=./data.sqlite

# --- Admin panel ------------------------------------------------------------
# Required for /api/admin. Must be at least 16 characters; if unset the admin
# API is disabled entirely. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Telegram webhook -------------------------------------------------------
# Serverless hosts (Vercel) cannot run long polling, so production receives
# updates on POST /api/telegram/webhook instead.
#
# Random string Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Without it the webhook endpoint refuses every request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# 1 on serverless (webhook), 0 locally (long polling). Never run both at once —
# each update would be handled twice.
USE_TELEGRAM_WEBHOOK=0

# Public URL of THIS backend. Used by scripts/setup-bot.js to register the
# webhook, e.g. https://zenfit-backend.vercel.app
API_BASE_URL=http://localhost:8787

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Do not use * in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Payments (optional, not yet wired to a live merchant account) ----------
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=
# CLICK_SECRET_KEY=

# --- Development only -------------------------------------------------------
# Set to 1 to enable POST /api/auth/dev and /api/payment/dev-activate so the app
# can be opened in a plain browser without Telegram. NEVER set this in production.
ALLOW_DEV_LOGIN=0
