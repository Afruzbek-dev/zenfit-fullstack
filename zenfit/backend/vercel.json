{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders?slot=morning",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/reminders?slot=morningLate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reminders?slot=evening",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
