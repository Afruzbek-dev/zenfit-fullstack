{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//": "Frankfurt, because Supabase lives in eu-central-1. Running in the default iad1 put the Atlantic between the function and every query.",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
